                    "label": "次日截止时间",
                    "default": "01:30",
                    "pipeline_type": "string",
                    "input_type": "time",
                    "verify": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                    "pattern_msg": "请选择 00:00 至 23:59 之间的截止时间"
                }
            ],
            "pipeline_override": {
                "单人吃鸡刷币": {
                    "custom_action_param": "{cutoff_time}"
