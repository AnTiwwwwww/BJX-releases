            }
        },
        "吃鸡局数": {
            "type": "select",
            "label": "打到",
            "description": "默认一直打，直到底部「本周还可获得飞沙令」右边的数字为 0。不看上面的卡片。每次匹配前把这个剩余数记到 debug/royale-weekly-left.txt，并按本地邮件配置把这一条发出去。大于 0 就再排。结束后游戏自己回主城。也可以改成只打固定局数。",
            "default_case": "打到上限",
