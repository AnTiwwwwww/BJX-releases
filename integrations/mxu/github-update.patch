new file mode 100644
index 0000000..a153aca
--- /dev/null
+++ b/src-tauri/src/commands/bjx_update.rs
@@ -0,0 +1,110 @@
+//! BJX: verified packages and an install/task-start exclusion gate.
+use std::io::Read;
+use std::sync::{atomic::Ordering, Arc};
+use sha2::{Digest, Sha256};
+use tauri::State;
+use super::types::MaaState;
+
+pub fn begin_install(state: &MaaState) -> Result<(), String> {
+    // run_task_impl checks the flag while holding this same mutex.
+    let instances = state.instances.lock().map_err(|e| e.to_string())?;
+    if state.active_pretasks.load(Ordering::SeqCst) != 0 ||
+        instances.values().any(|i| i.tasker.as_ref().is_some_and(|t| t.running())) {
+        return Err("BJX_TASKS_RUNNING".into());
+    }
+    state.update_in_progress.compare_exchange(false, true, Ordering::SeqCst, Ordering::SeqCst)
+        .map_err(|_| "BJX_UPDATE_IN_PROGRESS".to_string())?;
+    Ok(())
+}
+
+pub struct PretaskGuard<'a>(&'a MaaState);
+
+impl Drop for PretaskGuard<'_> {
+    fn drop(&mut self) {
+        self.0.active_pretasks.fetch_sub(1, Ordering::SeqCst);
+    }
+}
+
+pub fn begin_pretask(state: &MaaState) -> Result<PretaskGuard<'_>, String> {
+    // Share the install gate's mutex so neither side can pass a stale busy check.
+    let _instances = state.instances.lock().map_err(|e| e.to_string())?;
+    if state.update_in_progress.load(Ordering::SeqCst) {
+        return Err("BJX_UPDATE_IN_PROGRESS".into());
+    }
+    state.active_pretasks.fetch_add(1, Ordering::SeqCst);
+    Ok(PretaskGuard(state))
+}
+
+#[tauri::command]
+pub fn bjx_begin_update(state: State<Arc<MaaState>>) -> Result<(), String> {
+    begin_install(&state)
+}
+
+#[tauri::command]
+pub fn bjx_end_update(state: State<Arc<MaaState>>) {
+    state.update_in_progress.store(false, Ordering::SeqCst);
+}
+
+#[tauri::command]
+pub fn verify_update_sha256(file_path: String, expected: String) -> Result<(), String> {
+    if expected.len() != 64 || !expected.bytes().all(|c| c.is_ascii_hexdigit()) {
+        return Err("BJX_INVALID_CHECKSUM".into());
+    }
+    let mut file = std::fs::File::open(file_path).map_err(|e| e.to_string())?;
+    let mut hasher = Sha256::new();
+    let mut buffer = [0u8; 65536];
+    loop {
+        let count = file.read(&mut buffer).map_err(|e| e.to_string())?;
+        if count == 0 { break; }
+        hasher.update(&buffer[..count]);
+    }
+    if format!("{:x}", hasher.finalize()) != expected.to_ascii_lowercase() {
+        return Err("BJX_CHECKSUM_MISMATCH".into());
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn bjx_update_and_pretask_exclude_each_other_and_release_on_return() {
+        let state = MaaState::default();
+        {
+            let _first = begin_pretask(&state).unwrap();
+            {
+                let _second = begin_pretask(&state).unwrap();
+                assert!(begin_install(&state).is_err());
+            }
+            assert!(begin_install(&state).is_err());
+        }
+        assert_eq!(state.active_pretasks.load(Ordering::SeqCst), 0);
+        assert!(begin_install(&state).is_ok());
+        assert!(begin_pretask(&state).is_err());
+        state.update_in_progress.store(false, Ordering::SeqCst);
+        assert!(begin_pretask(&state).is_ok());
+        assert!(begin_install(&state).is_ok());
+    }
+    #[test]
+    fn bjx_update_gate_is_exclusive_and_releasable() {
+        let state = MaaState::default();
+        assert!(begin_install(&state).is_ok());
+        assert!(state.update_in_progress.load(Ordering::SeqCst));
+        assert!(begin_install(&state).is_err());
+        state.update_in_progress.store(false, Ordering::SeqCst);
+        assert!(begin_install(&state).is_ok());
+    }
+    #[test]
+    fn bjx_update_hash_rejects_corruption_and_missing_digest() {
+        let path = std::env::temp_dir().join(format!("bjx-hash-{}.zip", std::process::id()));
+        std::fs::write(&path, b"abc").unwrap();
+        let path_str = path.to_string_lossy().to_string();
+        let expected = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad".to_string();
+        assert!(verify_update_sha256(path_str.clone(), expected.clone()).is_ok());
+        assert!(verify_update_sha256(path_str.clone(), expected.to_uppercase()).is_ok());
+        assert!(verify_update_sha256(path_str.clone(), String::new()).is_err());
+        std::fs::write(&path, b"tampered").unwrap();
+        assert!(verify_update_sha256(path_str, expected).is_err());
+        std::fs::remove_file(path).unwrap();
+    }
+}
