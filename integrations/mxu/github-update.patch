diff --git a/src/services/startupGuard.ts b/src/services/startupGuard.ts
new file mode 100644
index 0000000..193d5f2
--- /dev/null
+++ b/src/services/startupGuard.ts
@@ -0,0 +1,190 @@
+import type {
+  OptionDefinition,
+  OptionValue,
+  ProjectInterface,
+  SelectedTask,
+} from '@/types/interface';
+import type { TaskConfig } from '@/types/maa';
+import {
+  buildPretaskDef,
+  getPretaskItem,
+  getPretaskItems,
+  isPretaskName,
+  pretaskName,
+  serializePretaskOptions,
+} from '@/types/pretasks';
+import { getMxuSpecialTask } from '@/types/specialTasks';
+import { isTaskCompatible } from '@/stores/helpers';
+
+export const STARTUP_GUARD_INVALID = 'MXU_STARTUP_GUARD_INVALID';
+
+export interface StartupGuardPayload {
+  run_id: string;
+  options: Record<string, unknown>;
+  tasks: { name: string; entry: string; options: Record<string, unknown> }[];
+}
+
+export interface StartupGuardPlan {
+  exec: string;
+  args: string[];
+  entry: string;
+  payload: StartupGuardPayload;
+  taskIndexById: ReadonlyMap<string, number>;
+}
+
+function validKeys(value: unknown): value is string[] | undefined {
+  return (
+    value === undefined ||
+    (Array.isArray(value) && value.every((key) => typeof key === 'string' && key.length > 0))
+  );
+}
+
+/** Reuse PI value/default semantics, then project the explicit allowlist and remove password fields. */
+function allowedOptions(
+  referencedKeys: string[] | undefined,
+  allowlist: string[] | undefined,
+  values: Record<string, OptionValue>,
+  pi: ProjectInterface,
+  allOptions: Record<string, OptionDefinition>,
+  controllerName?: string,
+  resourceName?: string,
+): Record<string, unknown> {
+  const serialized = serializePretaskOptions(
+    { exec: '', option: referencedKeys },
+    values,
+    { ...pi, option: allOptions },
+    controllerName,
+    resourceName,
+  );
+  const active = serialized ? (JSON.parse(serialized) as Record<string, unknown>) : {};
+  const entries: [string, unknown][] = [];
+  for (const key of new Set(allowlist ?? [])) {
+    if (!Object.prototype.hasOwnProperty.call(active, key)) continue;
+    const definition = allOptions[key];
+    let value = active[key];
+    if (definition?.type === 'input' || definition?.type === 'hotkey') {
+      const fields = definition.type === 'input' ? definition.inputs : definition.hotkeys;
+      const input = value as Record<string, unknown>;
+      value = Object.fromEntries(
+        fields.filter((field) => !field.password).map((field) => [field.name, input[field.name]]),
+      );
+    }
+    entries.push([key, value]);
+  }
+  return Object.fromEntries(entries);
+}
+
+/** The caller supplies this run's selected tasks, including one-shot/start-from filtering. */
+export function buildStartupGuardPlan(
+  pi: ProjectInterface | null | undefined,
+  selectedTasks: readonly SelectedTask[],
+  globalValues: Record<string, OptionValue>,
+  controllerName?: string,
+  resourceName?: string,
+): StartupGuardPlan | undefined {
+  const guard = pi?.startup_guard;
+  if (!guard || !pi) return undefined;
+  if (
+    typeof guard.exec !== 'string' ||
+    !guard.exec.trim() ||
+    typeof guard.entry !== 'string' ||
+    !guard.entry.trim() ||
+    !validKeys(guard.option) ||
+    !validKeys(guard.task_option) ||
+    (guard.args !== undefined &&
+      (!Array.isArray(guard.args) || !guard.args.every((arg) => typeof arg === 'string')))
+  ) {
+    throw new Error(STARTUP_GUARD_INVALID);
+  }
+  const pretaskOrder = getPretaskItems(pi).map(pretaskName);
+  const orderedTasks = [
+    ...selectedTasks
+      .filter((task) => isPretaskName(task.taskName))
+      .sort((a, b) => pretaskOrder.indexOf(a.taskName) - pretaskOrder.indexOf(b.taskName)),
+    ...selectedTasks.filter((task) => !isPretaskName(task.taskName)),
+  ];
+  const allOptions = pi.option ?? {};
+  const payload: StartupGuardPayload = {
+    run_id: crypto.randomUUID(),
+    options: allowedOptions(
+      guard.option,
+      guard.option,
+      globalValues,
+      pi,
+      allOptions,
+      controllerName,
+      resourceName,
+    ),
+    tasks: [],
+  };
+  const taskIndexById = new Map<string, number>();
+  for (const selected of orderedTasks) {
+    const pretask = getPretaskItem(pi, selected.taskName);
+    const special = getMxuSpecialTask(selected.taskName);
+    const definition = pretask
+      ? buildPretaskDef(pretask)
+      : (special?.taskDef ?? pi.task.find((task) => task.name === selected.taskName));
+    if (!definition || !isTaskCompatible(definition, controllerName, resourceName)) continue;
+    if (taskIndexById.has(selected.id) || definition.entry === guard.entry)
+      throw new Error(STARTUP_GUARD_INVALID);
+    taskIndexById.set(selected.id, payload.tasks.length);
+    payload.tasks.push({
+      name: selected.taskName,
+      entry: definition.entry,
+      options: allowedOptions(
+        definition.option,
+        guard.task_option,
+        selected.optionValues ?? {},
+        pi,
+        special?.optionDefs ?? allOptions,
+        controllerName,
+        resourceName,
+      ),
+    });
+  }
+  return {
+    exec: guard.exec,
+    args: [...(guard.args ?? []), JSON.stringify(payload)],
+    entry: guard.entry,
+    payload,
+    taskIndexById,
+  };
+}
+
+/** Append the guard last so task/global overrides cannot replace its payload or successor. */
+export function wrapTaskWithStartupGuard(
+  plan: StartupGuardPlan | undefined,
+  selectedTaskId: string,
+  config: TaskConfig,
+): TaskConfig {
+  if (!plan) return config;
+  const taskIndex = plan.taskIndexById.get(selectedTaskId);
+  if (taskIndex === undefined || config.entry !== plan.payload.tasks[taskIndex].entry)
+    throw new Error(STARTUP_GUARD_INVALID);
+  const original = JSON.parse(config.pipeline_override) as unknown;
+  if (original === null || typeof original !== 'object') throw new Error(STARTUP_GUARD_INVALID);
+  const overrides = Array.isArray(original) ? [...original] : [original];
+  overrides.push({
+    [plan.entry]: {
+      enabled: true,
+      custom_action_param: { ...plan.payload, task_index: taskIndex },
+      next: [config.entry],
+    },
+  });
+  return { ...config, entry: plan.entry, pipeline_override: JSON.stringify(overrides) };
+}
+
+export async function runStartupGuard(
+  plan: StartupGuardPlan | undefined,
+  callbacks: {
+    throwIfStopped: () => void;
+    run: (plan: StartupGuardPlan) => Promise<number>;
+    exitCodeError: (code: number) => string;
+  },
+): Promise<void> {
+  if (!plan) return;
+  callbacks.throwIfStopped();
+  const code = await callbacks.run(plan);
+  callbacks.throwIfStopped();
+  if (code !== 0) throw new Error(callbacks.exitCodeError(code));
+}
