+// Returns (all queued tasks finished, current task succeeded). Unknown/internal IDs
+// and node-level failures do not change the queue. A recoverable node failure can
+// therefore still finish successfully through its pipeline's on_error branch.
+fn apply_task_callback(
+    state: &mut TaskRunState,
+    task_id: i64,
+    message: &str,
+    stopping: bool,
+) -> Option<(bool, bool)> {
+    let index = state.pending_task_ids.iter().position(|&id| id == task_id)?;
+    if message == "Tasker.Task.Starting" {
+        state.current_task_index = index;
+        if !stopping {
+            if let Some(selected_id) = state.mappings.get(&task_id).cloned() {
+                state.statuses.insert(selected_id, "running".to_string());
+            }
+        }
+        return Some((false, false));
+    }
+    if message != "Tasker.Task.Succeeded" && message != "Tasker.Task.Failed" {
+        return None;
+    }
+    let selected_id = state.mappings.get(&task_id).cloned();
+    // Preserve a failure already recorded by MXU's explicit stop command, even if
+    // a late native completion arrives after the Tasker stopping flag has cleared.
+    let already_cancelled = state.overall_status.as_deref() == Some("Failed") &&
+        selected_id.as_ref().and_then(|id| state.statuses.get(id)).map(String::as_str) == Some("failed");
+    let success = message == "Tasker.Task.Succeeded" && !stopping && !already_cancelled;
+    if let Some(id) = selected_id {
+        state.statuses.insert(id, if success { "succeeded" } else { "failed" }.to_string());
+    }
+    if stopping {
+        // post_stop clears native pending tasks without emitting completion callbacks.
+        for status in state.statuses.values_mut() {
+            if status == "pending" || status == "running" {
+                *status = "failed".to_string();
+            }
+        }
+    }
+    let all_done = state.pending_task_ids.iter().all(|id| {
+        state.mappings.get(id).and_then(|selected| state.statuses.get(selected))
+            .map(|status| status == "succeeded" || status == "failed").unwrap_or(false)
+    });
+    if all_done {
+        state.overall_status = Some(if state.statuses.values().any(|status| status == "failed") {
+            "Failed"
+        } else {
+            "Succeeded"
+        }.to_string());
+    }
+    Some((all_done, success))
+}
