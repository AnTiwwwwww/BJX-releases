@@ -0,0 +1,336 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import ts from 'typescript';
+import { runPretaskSequence, findWindowAfterPretask } from '../src/services/pretaskService';
+import {
+  buildStartupGuardPlan,
+  runStartupGuard,
+  wrapTaskWithStartupGuard,
+  STARTUP_GUARD_INVALID,
+} from '../src/services/startupGuard';
+
+const CANCELLED = 'MXU_PRE_ACTION_CANCELLED';
+
+test('pre-tasks execute in order and stop before later items on nonzero exit', async () => {
+  const visited: number[] = [];
+  const completed: number[] = [];
+  await assert.rejects(
+    runPretaskSequence([1, 2, 3], {
+      throwIfStopped() {},
+      run: async (item) => {
+        visited.push(item);
+        return item === 2 ? 17 : 0;
+      },
+      completed: (item) => completed.push(item),
+      exitCodeError: (code) => `exit ${code}`,
+    }),
+    /exit 17/,
+  );
+  assert.deepEqual(visited, [1, 2]);
+  assert.deepEqual(completed, [1]);
+});
+
+test('pre-task exceptions propagate and no later helper starts', async () => {
+  const visited: number[] = [];
+  await assert.rejects(
+    runPretaskSequence([1, 2], {
+      throwIfStopped() {},
+      run: async (item) => {
+        visited.push(item);
+        throw new Error('spawn failed');
+      },
+      completed() {
+        assert.fail('failed helper cannot complete');
+      },
+      exitCodeError: String,
+    }),
+    /spawn failed/,
+  );
+  assert.deepEqual(visited, [1]);
+});
+
+test('cancellation before and after a helper prevents completion and next helper', async () => {
+  for (const before of [true, false]) {
+    let stopped = before;
+    let runCount = 0;
+    await assert.rejects(
+      runPretaskSequence([1, 2], {
+        throwIfStopped: () => {
+          if (stopped) throw new Error(CANCELLED);
+        },
+        run: async () => {
+          runCount++;
+          stopped = true;
+          return 0;
+        },
+        completed() {
+          assert.fail('cancelled helper cannot complete');
+        },
+        exitCodeError: String,
+      }),
+      new RegExp(CANCELLED),
+    );
+    assert.equal(runCount, before ? 0 : 1);
+  }
+});
+
+test('successful pre-tasks request reconnection, while an empty set does not', async () => {
+  const callbacks = {
+    throwIfStopped() {},
+    run: async () => 0,
+    completed() {},
+    exitCodeError: String,
+  };
+  assert.equal(await runPretaskSequence([], callbacks), false);
+  assert.equal(await runPretaskSequence([1, 2], callbacks), true);
+});
+
+test('changed window title can recover after startup only when the match is unique', () => {
+  const current = { window_name: '剑网3 登录', handle: 2 };
+  const other = { window_name: '剑网3 其他', handle: 3 };
+  assert.equal(findWindowAfterPretask([current], '剑网3 旧标题', true), current);
+  assert.equal(findWindowAfterPretask([current], '剑网3 旧标题', false), undefined);
+  assert.equal(findWindowAfterPretask([current, other], '剑网3 旧标题', true), undefined);
+  assert.equal(
+    findWindowAfterPretask([current, { ...current, handle: 4 }], current.window_name, true),
+    undefined,
+  );
+});
+
+// Execute the actual Toolbar startup callback, replacing only its UI/native boundaries.
+const source = readFileSync(new URL('../src/components/Toolbar.tsx', import.meta.url), 'utf8');
+const ast = ts.createSourceFile(
+  'Toolbar.tsx',
+  source,
+  ts.ScriptTarget.Latest,
+  true,
+  ts.ScriptKind.TSX,
+);
+let startup: ts.ArrowFunction | undefined;
+function visit(node: ts.Node) {
+  if (
+    ts.isVariableDeclaration(node) &&
+    node.name.getText(ast) === 'startTasksForInstance' &&
+    node.initializer &&
+    ts.isCallExpression(node.initializer)
+  ) {
+    startup = node.initializer.arguments[0] as ts.ArrowFunction;
+  }
+  ts.forEachChild(node, visit);
+}
+visit(ast);
+assert.ok(startup, 'Toolbar startup callback must exist');
+const compiled = ts.transpile(`(${startup.getText(ast)})`, { target: ts.ScriptTarget.ES2022 });
+
+function toolbarHarness(
+  mode: 'success' | 'nonzero' | 'throw' | 'cancel',
+  onlyPretask = false,
+  windowCount = 1,
+  guardMode?: 'success' | 'maintenance' | 'unknown' | 'cancel' | 'code22' | 'throw',
+) {
+  const calls: string[] = [];
+  const messages: string[] = [];
+  let cancelled = false;
+  const pretasks = [{ name: 'launch', exec: 'launch.exe' }];
+  const selectedTasks = [{ id: 'launch', taskName: '__MXU_PRETASK__launch' }];
+  if (!onlyPretask) selectedTasks.push({ id: 'login', taskName: 'login' });
+  const instance = {
+    id: 'test',
+    name: 'test',
+    isRunning: false,
+    selectedTasks,
+    savedDevice: { windowName: '剑网3 旧标题' },
+  };
+  const ui = { status: null as string | null, connected: 'Connected' };
+  const lastStartCancelledRef = { current: false };
+  const start = vm.runInNewContext(compiled, {
+    Error,
+    PRE_ACTION_CANCELLED_ERROR: CANCELLED,
+    STARTUP_GUARD_INVALID,
+    buildStartupGuardPlan,
+    runStartupGuard,
+    wrapTaskWithStartupGuard,
+    lastStartCancelledRef,
+    preActionControlledInstanceIdRef: { current: null },
+    projectInterface: {
+      controller: [{ name: 'game', type: 'Win32' }],
+      resource: [{ name: 'game' }],
+      pretask: pretasks,
+      task: [{ name: 'login', entry: 'Login' }],
+      startup_guard: guardMode
+        ? { exec: 'guard.exe', entry: 'Guard', args: ['--check'] }
+        : undefined,
+    },
+    selectedController: {},
+    selectedResource: {},
+    instanceConnectionStatus: { test: 'Connected' },
+    instanceResourceLoaded: { test: true },
+    basePath: 'test-only',
+    translations: {},
+    useAppStore: { getState: () => ({ globalOptionValues: {} }) },
+    t: (key: string, values?: { code?: number }) =>
+      values?.code === undefined ? key : `${key}: ${values.code}`,
+    log: { info() {}, warn() {}, error() {} },
+    addLog(_id: string, item: { message: string }) {
+      messages.push(item.message);
+    },
+    filterTasksForRun: (tasks: unknown) => tasks,
+    resolveCompatTaskDef() {},
+    isTaskCompatible: () => true,
+    validateInstanceCheckboxCounts: () => [],
+    requiresUnlockedWorkstation: () => true,
+    getPretaskItems: () => pretasks,
+    pretaskName: (p: { name: string }) => '__MXU_PRETASK__' + p.name,
+    isPretaskName: (name: string) => name.startsWith('__MXU_PRETASK__'),
+    getPretaskItem: () => pretasks[0],
+    resolveI18nText: (text: unknown) => text,
+    buildPretaskArgs: () => ['{}'],
+    runPretaskSequence,
+    findWindowAfterPretask,
+    beginPreActionControl: async () => {
+      calls.push('begin');
+    },
+    endPreActionControl: async () => {
+      calls.push('end');
+    },
+    throwIfPreActionStopped: () => {
+      if (cancelled) throw new Error(CANCELLED);
+    },
+    updateInstance: (_id: string, changes: object) => Object.assign(instance, changes),
+    setInstanceConnectionStatus: (_id: string, state: string) => {
+      ui.connected = state;
+    },
+    setInstanceTaskStatus: (_id: string, status: string | null) => {
+      ui.status = status;
+    },
+    setInstanceCurrentTaskId() {},
+    clearScheduleExecution() {},
+    setIsStopping() {},
+    normalizeAgentConfigs: () => undefined,
+    ensureMaaInitialized: async () => {
+      calls.push('init');
+    },
+    isDesktopWindowControllerType: (type: string) => type === 'Win32',
+    getDesktopWindowFilters: () => ({ classRegex: 'KGWin32App', titleRegex: '剑网3' }),
+    buildDesktopWindowControllerConfig: (_c: unknown, handle: number) => ({ handle }),
+    maaService: {
+      isWorkstationLocked: async () => false,
+      runPretask: async (_id: string, program: string) => {
+        calls.push(program === 'guard.exe' ? 'guard' : 'pretask');
+        assert.equal(instance.isRunning, true, 'automatic updates must see startup as busy');
+        if (program === 'guard.exe') {
+          if (guardMode === 'throw') throw new Error('guard spawn failed');
+          if (guardMode === 'cancel') cancelled = true;
+          return guardMode === 'maintenance'
+            ? 20
+            : guardMode === 'unknown'
+              ? 21
+              : guardMode === 'code22'
+                ? 22
+                : 0;
+        }
+        if (mode === 'throw') throw new Error('spawn failed');
+        if (mode === 'cancel') cancelled = true;
+        return mode === 'nonzero' ? 17 : 0;
+      },
+      createInstance: async () => {
+        calls.push('create');
+      },
+      findWin32Windows: async () =>
+        Array.from({ length: windowCount }, (_, i) => ({
+          window_name: '剑网3 登录' + i,
+          class_name: 'KGWin32App',
+          handle: 200 + i,
+        })),
+      onCallback: async () => () => {},
+      connectController: async (_id: string, config: { handle: number }) => {
+        calls.push('connect:' + config.handle);
+        throw new Error('TEST_AFTER_CONNECT');
+      },
+      getInstanceState: async () => {
+        calls.push('cached-connection');
+        return { connectionStatus: 'Connected', resourceLoaded: true };
+      },
+    },
+  });
+  return { calls, messages, instance, ui, lastStartCancelledRef, run: () => start(instance) };
+}
+
+test('Toolbar runs the mandatory guard before any launch pretask and shares the update-visible busy state', async () => {
+  const h = toolbarHarness('success', true, 1, 'success');
+  assert.equal(await h.run(), true);
+  assert.deepEqual(h.calls, ['begin', 'guard', 'end', 'begin', 'pretask', 'end']);
+  assert.equal(h.ui.status, 'Succeeded');
+});
+
+test('Toolbar maintenance, unknown status and spawn failures skip all later startup work', async () => {
+  for (const mode of ['maintenance', 'unknown', 'throw'] as const) {
+    const h = toolbarHarness('success', false, 1, mode);
+    assert.equal(await h.run(), false);
+    assert.deepEqual(h.calls, ['begin', 'guard', 'end']);
+    assert.equal(h.ui.status, 'Failed');
+    assert.equal(h.instance.isRunning, false);
+    if (mode !== 'throw')
+      assert.ok(
+        h.messages.some((message) =>
+          message.includes(
+            mode === 'maintenance' ? 'startupGuardMaintenance' : 'startupGuardUnknown',
+          ),
+        ),
+      );
+  }
+});
+
+test('Toolbar cancellation during guard or helper exit 22 never connects or launches the game', async () => {
+  for (const mode of ['cancel', 'code22'] as const) {
+    const h = toolbarHarness('success', false, 1, mode);
+    assert.equal(await h.run(), false);
+    assert.deepEqual(h.calls, ['begin', 'guard', 'end']);
+    assert.equal(h.ui.status, null);
+    assert.equal(h.lastStartCancelledRef.current, true);
+  }
+});
+
+test('Toolbar blocks controller connection after nonzero exit or spawn exception', async () => {
+  for (const mode of ['nonzero', 'throw'] as const) {
+    const h = toolbarHarness(mode);
+    assert.equal(await h.run(), false);
+    assert.deepEqual(h.calls, ['begin', 'pretask', 'end']);
+    assert.equal(h.ui.status, 'Failed');
+    assert.equal(h.instance.isRunning, false);
+  }
+});
+
+test('Toolbar cancellation preserves cancelled status and never connects', async () => {
+  const h = toolbarHarness('cancel');
+  assert.equal(await h.run(), false);
+  assert.deepEqual(h.calls, ['begin', 'pretask', 'end']);
+  assert.equal(h.lastStartCancelledRef.current, true);
+  assert.equal(h.ui.status, null);
+});
+
+test('Toolbar allows a pretask-only run without connecting or loading a resource', async () => {
+  const h = toolbarHarness('success', true);
+  assert.equal(await h.run(), true);
+  assert.deepEqual(h.calls, ['begin', 'pretask', 'end']);
+  assert.equal(h.ui.status, 'Succeeded');
+  assert.equal(h.ui.connected, 'Disconnected');
+  assert.equal(h.instance.isRunning, false);
+});
+
+test('Toolbar refreshes an existing controller and accepts a unique new window title', async () => {
+  const h = toolbarHarness('success');
+  await h.run();
+  assert.deepEqual(h.calls, ['begin', 'pretask', 'end', 'init', 'create', 'connect:200']);
+});
+
+test('Toolbar does not select among multiple new windows after startup', async () => {
+  const h = toolbarHarness('success', false, 2);
+  assert.equal(await h.run(), false);
+  assert.equal(
+    h.calls.some((call) => call.startsWith('connect:')),
+    false,
+  );
+});
