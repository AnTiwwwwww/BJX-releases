+#[cfg(test)]
+mod bjx_tests {
+    use super::*;
+    #[test]
+    fn bjx_update_preserves_user_data_and_replaces_resources() {
+        let root = std::env::temp_dir().join(format!("bjx-install-{}", std::process::id()));
+        let old = root.join("installed");
+        let new = root.join("package");
+        std::fs::create_dir_all(old.join("resource")).unwrap();
+        std::fs::create_dir_all(old.join("config")).unwrap();
+        std::fs::create_dir_all(new.join("resource")).unwrap();
+        std::fs::create_dir_all(new.join("config")).unwrap();
+        std::fs::write(old.join("resource/obsolete.json"), "old").unwrap();
+        std::fs::write(new.join("resource/new.json"), "new").unwrap();
+        for name in ["accounts.csv", "notify.local.json", "config/instances.json"] {
+            std::fs::write(old.join(name), "private-fixture").unwrap();
+            std::fs::write(new.join(name), "must-not-overwrite").unwrap();
+        }
+        apply_full_update(new.to_string_lossy().into(), old.to_string_lossy().into()).unwrap();
+        for name in ["accounts.csv", "notify.local.json", "config/instances.json"] {
+            assert_eq!(std::fs::read_to_string(old.join(name)).unwrap(), "private-fixture");
+        }
+        assert!(!old.join("resource/obsolete.json").exists());
+        assert_eq!(std::fs::read_to_string(old.join("resource/new.json")).unwrap(), "new");
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
