new file mode 100644
index 0000000..6ee1c59
--- /dev/null
+++ b/src/services/pretaskService.ts
@@ -0,0 +1,32 @@
+/** Run PI pre-tasks before any controller/resource work, aborting at the first failure. */
+export async function runPretaskSequence<T>(
+  items: readonly T[],
+  callbacks: {
+    throwIfStopped: () => void;
+    run: (item: T) => Promise<number>;
+    completed: (item: T) => void;
+    exitCodeError: (code: number) => string;
+  },
+): Promise<boolean> {
+  for (const item of items) {
+    callbacks.throwIfStopped();
+    const code = await callbacks.run(item);
+    callbacks.throwIfStopped();
+    if (code !== 0) throw new Error(callbacks.exitCodeError(code));
+    callbacks.completed(item);
+  }
+  // Even a successful pre-task may have replaced a window behind a stale connection.
+  return items.length > 0;
+}
+
+/** A restarted application may change its title; never choose between ambiguous windows. */
+export function findWindowAfterPretask<T extends { window_name: string }>(
+  windows: readonly T[],
+  savedTitle: string,
+  pretaskCompleted: boolean,
+): T | undefined {
+  const exact = windows.filter((window) => window.window_name === savedTitle);
+  if (exact.length === 1) return exact[0];
+  if (exact.length > 1) return undefined;
+  return pretaskCompleted && windows.length === 1 ? windows[0] : undefined;
+}
