+// BJX user-owned data is never replaced by a full update.
+fn is_bjx_user_data(name: &str) -> bool {
+    let lower = name.to_ascii_lowercase();
+    ["config", "cache", "debug", "logs", "accounts.csv"].contains(&lower.as_str()) ||
+        lower.contains(".local.") || lower.starts_with("accounts.csv.")
