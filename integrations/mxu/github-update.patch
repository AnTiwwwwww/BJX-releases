diff --git a/src/services/githubUpdate.ts b/src/services/githubUpdate.ts
new file mode 100644
index 0000000..960f6ba
--- /dev/null
+++ b/src/services/githubUpdate.ts
@@ -0,0 +1,89 @@
+import * as semver from 'semver';
+
+// BJX publishes complete Windows x64 packages; never guess a source/archive asset.
+export interface ReleaseAsset {
+  name: string;
+  size: number;
+  browser_download_url: string;
+  digest?: string | null;
+}
+export interface Release {
+  tag_name: string;
+  body: string | null;
+  draft: boolean;
+  prerelease: boolean;
+  assets: ReleaseAsset[];
+}
+export interface GitHubUpdateOptions {
+  githubUrl: string;
+  currentVersion: string;
+  channel?: string;
+  projectName: string;
+  os: string;
+  arch: string;
+}
+
+export function isReleaseVersion(version: string): boolean {
+  const parsed = semver.parse(version.replace(/^v/i, ''));
+  return !!parsed && (parsed.prerelease.length === 0 ||
+    ['beta', 'rc'].includes(String(parsed.prerelease[0])));
+}
+
+export async function checkGitHubUpdate(
+  options: GitHubUpdateOptions,
+  fetcher: (url: string) => Promise<Response>,
+) {
+  const repo = new URL(options.githubUrl);
+  if (repo.origin !== 'https://github.com' || repo.username || repo.password ||
+      repo.search || repo.hash || !/^\/[\w.-]+\/[\w.-]+\/?$/.test(repo.pathname)) {
+    throw new Error('Invalid GitHub repository URL');
+  }
+  if (options.os !== 'windows' || !['x86_64', 'amd64', 'x64'].includes(options.arch)) {
+    throw new Error('BJX updates require Windows x64');
+  }
+  if (!isReleaseVersion(options.currentVersion) || !/^[\w.-]+$/.test(options.projectName)) {
+    throw new Error('Invalid release version or project name');
+  }
+  const repoPath = repo.pathname.replace(/\/$/, '');
+  const response = await fetcher(`https://api.github.com/repos${repoPath}/releases?per_page=100`);
+  if (!response.ok) throw new Error(`GitHub release check failed: HTTP ${response.status}`);
+  const releases: Release[] = await response.json();
+  if (!Array.isArray(releases)) throw new Error('Invalid GitHub release response');
+  const current = options.currentVersion.replace(/^v/i, '');
+  const candidates = releases.filter((r) => !r.draft && isReleaseVersion(r.tag_name) &&
+    (options.channel === 'beta' || (!r.prerelease && !semver.prerelease(r.tag_name))) &&
+    semver.gt(r.tag_name, current)).sort((a, b) => semver.rcompare(a.tag_name, b.tag_name));
+  if (!candidates.length) {
+    return { hasUpdate: false, versionName: current, releaseNote: '' };
+  }
+  const release = candidates[0];
+  const version = semver.valid(release.tag_name)!;
+  const filename = `${options.projectName}-win-x86_64-v${version}.zip`;
+  const asset = release.assets.find((a) => a.name === filename);
+  if (!asset || asset.size <= 0) throw new Error('Release has no complete Windows x64 package');
+  const assetUrl = (name: string) => `https://github.com${repoPath}/releases/download/${encodeURIComponent(release.tag_name)}/${name}`;
+  if (asset.browser_download_url !== assetUrl(filename)) throw new Error('Unexpected release asset URL');
+  let sha256: string | undefined;
+  if (asset.digest) {
+    const digest = /^sha256:([a-f\d]{64})$/i.exec(asset.digest);
+    if (!digest) throw new Error('Invalid release digest');
+    sha256 = digest[1].toLowerCase();
+  } else {
+    const checksumName = `${filename}.sha256`;
+    const checksum = release.assets.find((a) => a.name === checksumName);
+    if (!checksum || checksum.browser_download_url !== assetUrl(checksumName) || checksum.size > 4096) {
+      throw new Error('Release is missing SHA-256 verification');
+    }
+    const checksumResponse = await fetcher(checksum.browser_download_url);
+    if (!checksumResponse.ok) throw new Error('Cannot download release checksum');
+    const match = /^([a-f\d]{64})\s+\*?([^\r\n]+)\s*$/i.exec(await checksumResponse.text());
+    if (!match || match[2] !== filename) throw new Error('Invalid release checksum');
+    sha256 = match[1].toLowerCase();
+  }
+  return {
+    hasUpdate: true, versionName: version, releaseNote: release.body || '',
+    channel: release.prerelease ? 'beta' : 'stable',
+    downloadUrl: asset.browser_download_url, filename, fileSize: asset.size,
+    sha256, updateType: 'full' as const, downloadSource: 'github' as const,
+  };
+}
