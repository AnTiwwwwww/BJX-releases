+            state.pending_task_ids.push(id);
+            state.statuses.insert(selected.clone(), "pending".to_string());
+            state.mappings.insert(id, selected);
+        }
+        state.overall_status = Some("Running".to_string());
+        state
+    }
+
+    #[test]
+    fn external_stop_normalizes_success_and_settles_cleared_queue() {
+        let mut state = queue();
+        assert_eq!(apply_task_callback(&mut state, 1, "Tasker.Task.Starting", false), Some((false, false)));
+        // The custom action fails and synchronously posts a whole-queue stop.
+        assert_eq!(apply_task_callback(&mut state, 1, "Node.Action.Failed", true), None);
+        assert_eq!(apply_task_callback(&mut state, 1, "Tasker.Task.Succeeded", true), Some((true, false)));
+        assert!(state.statuses.values().all(|status| status == "failed"));
+        assert_eq!(state.overall_status.as_deref(), Some("Failed"));
+        // MaaTaskerPostStop has a separate unmapped ID and cannot overwrite the outcome.
+        assert_eq!(apply_task_callback(&mut state, 4, "Tasker.Task.Starting", true), None);
+        assert_eq!(apply_task_callback(&mut state, 4, "Tasker.Task.Succeeded", true), None);
+        assert_eq!(state.overall_status.as_deref(), Some("Failed"));
+    }
+
+    #[test]
+    fn recoverable_node_failure_does_not_fail_or_cancel_later_tasks() {
+        let mut state = queue();
+        apply_task_callback(&mut state, 1, "Tasker.Task.Starting", false);
+        assert_eq!(apply_task_callback(&mut state, 1, "Node.Action.Failed", false), None);
+        assert_eq!(apply_task_callback(&mut state, 1, "Tasker.Task.Succeeded", false), Some((false, true)));
+        assert_eq!(state.statuses["selected-2"], "pending");
+        for id in 2..=3 {
+            apply_task_callback(&mut state, id, "Tasker.Task.Starting", false);
+            apply_task_callback(&mut state, id, "Tasker.Task.Succeeded", false);
+        }
+        assert_eq!(state.overall_status.as_deref(), Some("Succeeded"));
+    }
+
+    #[test]
+    fn explicit_stop_and_prior_success_are_preserved() {
+        let mut state = queue();
+        apply_task_callback(&mut state, 1, "Tasker.Task.Succeeded", false);
+        apply_task_callback(&mut state, 2, "Tasker.Task.Starting", false);
+        assert_eq!(apply_task_callback(&mut state, 2, "Tasker.Task.Succeeded", true), Some((true, false)));
+        assert_eq!(state.statuses["selected-1"], "succeeded");
+        assert_eq!(state.statuses["selected-2"], "failed");
+        assert_eq!(state.statuses["selected-3"], "failed");
+        // A delayed completion after stopping becomes false must not turn red back to green.
+        assert_eq!(apply_task_callback(&mut state, 2, "Tasker.Task.Succeeded", false), Some((true, false)));
+    }
+
+    #[test]
+    fn normal_task_failure_keeps_the_existing_continue_policy() {
+        let mut state = queue();
+        assert_eq!(apply_task_callback(&mut state, 1, "Tasker.Task.Failed", false), Some((false, false)));
+        assert_eq!(state.statuses["selected-2"], "pending");
+        assert_eq!(state.overall_status.as_deref(), Some("Running"));
+    }
 }
 
