new file mode 100644
index 0000000..89b5afc
--- /dev/null
+++ b/tests/githubInstall.test.ts
@@ -0,0 +1,52 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import ts from 'typescript';
+
+// Exercise the real installUpdate entry point, with native I/O mocked at its boundary.
+const source = readFileSync(new URL('../src/services/updateService.ts', import.meta.url), 'utf8');
+const ast = ts.createSourceFile('updateService.ts', source, ts.ScriptTarget.Latest, true);
+const declaration = ast.statements.find((s) => ts.isFunctionDeclaration(s) && s.name?.text === 'installUpdate')!;
+const body = ts.transpile(declaration.getText(ast).replace(/^export /, ''), { target: ts.ScriptTarget.ES2022 });
+function harness(change?: (command: string, state: { instances: { isRunning: boolean }[] }) => void) {
+  const state = { instances: [{ isRunning: false }], projectInterface: { github: 'https://github.com/AnTiwwwwww/BJX-releases' } };
+  const calls: string[] = [];
+  const install = vm.runInNewContext(`let isInstalling = false; ${body}; installUpdate`, {
+    useAppStore: { getState: () => state },
+    i18n: { t: (key: string) => key },
+    log: { info() {}, warn() {}, error() {} },
+    invoke: async (command: string) => { calls.push(command); change?.(command, state); return null; },
+    backupConfigBeforeUpdate: async () => { calls.push('backup'); },
+    isExecutableInstaller: () => false,
+    dirname: async () => 'cache', joinPath: (...parts: string[]) => parts.join('/'),
+    getCacheDir: async () => 'cache', moveToOldFolder: async () => {},
+  });
+  return { state, calls, install: () => install({ zipPath: 'cache/update.zip', targetDir: 'BJX', newVersion: '0.4.2-beta.1', sha256: 'a'.repeat(64) }) };
+}
+test('manual install refuses running tasks before any native call or file mutation', async () => {
+  const h = harness(); h.state.instances[0].isRunning = true;
+  await assert.rejects(h.install(), /tasksRunning/);
+  assert.deepEqual(h.calls, []);
+});
+test('a task starting during hash verification also prevents installation', async () => {
+  const h = harness((cmd, state) => { if (cmd === 'verify_update_sha256') state.instances[0].isRunning = true; });
+  await assert.rejects(h.install(), /tasksRunning/);
+  assert.deepEqual(h.calls, ['verify_update_sha256']);
+});
+test('corrupt package and busy backend never reach extraction or backup', async () => {
+  for (const blocked of ['verify_update_sha256', 'bjx_begin_update']) {
+    const h = harness((cmd) => { if (cmd === blocked) throw new Error('rejected'); });
+    await assert.rejects(h.install());
+    assert.equal(h.calls.includes('backup'), false);
+    assert.equal(h.calls.includes('extract_zip'), false);
+    assert.equal(h.calls.includes('apply_full_update'), false);
+  }
+});
+test('successful install verifies first, acquires native gate, then applies and keeps gate until restart', async () => {
+  const h = harness();
+  assert.equal(await h.install(), true);
+  assert.deepEqual(h.calls.slice(0, 3), ['verify_update_sha256', 'bjx_begin_update', 'backup']);
+  assert.equal(h.calls.includes('apply_full_update'), true);
+  assert.equal(h.calls.includes('bjx_end_update'), false);
+});
diff --git a/tests/githubUpdate.test.ts b/tests/githubUpdate.test.ts
new file mode 100644
index 0000000..664704c
--- /dev/null
+++ b/tests/githubUpdate.test.ts
@@ -0,0 +1,63 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { checkGitHubUpdate, isReleaseVersion, type Release } from '../src/services/githubUpdate';
+
+const options = { githubUrl: 'https://github.com/AnTiwwwwww/BJX-releases', currentVersion: '0.4.1-beta.1', channel: 'beta', projectName: 'BJX', os: 'windows', arch: 'x86_64' };
+const hash = 'a'.repeat(64);
+function release(tag = 'v0.4.2-beta.1'): Release {
+  const name = `BJX-win-x86_64-${tag}.zip`;
+  return { tag_name: tag, draft: false, prerelease: tag.includes('-'), body: 'Update notes', assets: [{ name, size: 123, browser_download_url: `${options.githubUrl}/releases/download/${tag}/${name}`, digest: `sha256:${hash}` }] };
+}
+const fetchReleases = (releases: Release[]) => async () => new Response(JSON.stringify(releases));
+
+test('0.x beta and rc versions are updateable; debug, CI and malformed versions are not', () => {
+  for (const version of ['0.4.1-beta.1', 'v0.4.2-rc.1', '0.5.0']) assert.equal(isReleaseVersion(version), true);
+  for (const version of ['DEBUG_VERSION', '0.4.1-ci.2', 'latest', '0.4']) assert.equal(isReleaseVersion(version), false);
+});
+test('public release lookup needs no RID, CDK or token and selects exact package/digest', async () => {
+  const result = await checkGitHubUpdate(options, async (url) => {
+    assert.equal(url, 'https://api.github.com/repos/AnTiwwwwww/BJX-releases/releases?per_page=100');
+    return fetchReleases([release()])();
+  });
+  assert.equal(result.versionName, '0.4.2-beta.1');
+  assert.equal(result.sha256, hash);
+  assert.equal(result.releaseNote, 'Update notes');
+});
+test('semantic order, stable/beta channel, drafts, CI builds and downgrade protection', async () => {
+  const draft = { ...release('v2.0.0'), draft: true };
+  const releases = [release(), release('v0.4.10-beta.1'), release('v0.4.3'), draft, release('v3.0.0-ci.1')];
+  assert.equal((await checkGitHubUpdate(options, fetchReleases(releases))).versionName, '0.4.10-beta.1');
+  assert.equal((await checkGitHubUpdate({ ...options, channel: 'stable' }, fetchReleases(releases))).versionName, '0.4.3');
+  assert.equal((await checkGitHubUpdate({ ...options, currentVersion: '0.5.0' }, fetchReleases(releases))).hasUpdate, false);
+});
+test('no updates is a successful check, including empty/stable-only channel', async () => {
+  assert.equal((await checkGitHubUpdate(options, fetchReleases([]))).hasUpdate, false);
+  assert.equal((await checkGitHubUpdate({ ...options, channel: 'stable' }, fetchReleases([release()]))).hasUpdate, false);
+});
+test('never substitutes source zip, other architecture or arbitrary download URL', async () => {
+  for (const name of ['BJX-source-v0.4.2-beta.1.zip', 'BJX-win-arm64-v0.4.2-beta.1.zip']) {
+    const r = release(); r.assets[0].name = name;
+    await assert.rejects(checkGitHubUpdate(options, fetchReleases([r])));
+  }
+  const r = release(); r.assets[0].browser_download_url = 'https://example.com/update.zip';
+  await assert.rejects(checkGitHubUpdate(options, fetchReleases([r])));
+  await assert.rejects(checkGitHubUpdate({ ...options, os: 'linux' }, fetchReleases([release()])));
+});
+test('missing digest uses the exact .sha256 asset; filename and digest must match', async () => {
+  const r = release(); delete r.assets[0].digest;
+  r.assets.push({ ...r.assets[0], name: `${r.assets[0].name}.sha256`, browser_download_url: `${r.assets[0].browser_download_url}.sha256`, size: 100 });
+  for (const filename of [r.assets[0].name, 'wrong.zip']) {
+    const fetcher = async (url: string) => url.endsWith('.sha256') ? new Response(`${hash}  ${filename}\n`) : fetchReleases([r])();
+    if (filename === 'wrong.zip') await assert.rejects(checkGitHubUpdate(options, fetcher));
+    else assert.equal((await checkGitHubUpdate(options, fetcher)).sha256, hash);
+  }
+  r.assets.pop();
+  await assert.rejects(checkGitHubUpdate(options, fetchReleases([r])));
+});
+test('rate limits, network failure, invalid digest and repo URL fail closed', async () => {
+  for (const status of [403, 429, 500]) await assert.rejects(checkGitHubUpdate(options, async () => new Response('', { status })));
+  await assert.rejects(checkGitHubUpdate(options, async () => { throw new Error('offline'); }));
+  const r = release(); r.assets[0].digest = 'sha256:invalid';
+  await assert.rejects(checkGitHubUpdate(options, fetchReleases([r])));
+  await assert.rejects(checkGitHubUpdate({ ...options, githubUrl: 'https://github.com.evil.test/o/r' }, fetchReleases([r])));
+});
diff --git a/tests/pretaskStart.test.ts b/tests/pretaskStart.test.ts
new file mode 100644
index 0000000..55b86bc
--- /dev/null
+++ b/tests/pretaskStart.test.ts
@@ -0,0 +1,272 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import ts from 'typescript';
+import { runPretaskSequence, findWindowAfterPretask } from '../src/services/pretaskService';
+
+const CANCELLED = 'MXU_PRE_ACTION_CANCELLED';
+
+test('pre-tasks execute in order and stop before later items on nonzero exit', async () => {
+  const visited: number[] = [];
+  const completed: number[] = [];
+  await assert.rejects(
+    runPretaskSequence([1, 2, 3], {
+      throwIfStopped() {},
+      run: async (item) => {
+        visited.push(item);
+        return item === 2 ? 17 : 0;
+      },
+      completed: (item) => completed.push(item),
+      exitCodeError: (code) => `exit ${code}`,
+    }),
+    /exit 17/,
+  );
+  assert.deepEqual(visited, [1, 2]);
+  assert.deepEqual(completed, [1]);
+});
+
+test('pre-task exceptions propagate and no later helper starts', async () => {
+  const visited: number[] = [];
+  await assert.rejects(
+    runPretaskSequence([1, 2], {
+      throwIfStopped() {},
+      run: async (item) => {
+        visited.push(item);
+        throw new Error('spawn failed');
+      },
+      completed() {
+        assert.fail('failed helper cannot complete');
+      },
+      exitCodeError: String,
+    }),
+    /spawn failed/,
+  );
+  assert.deepEqual(visited, [1]);
+});
+
+test('cancellation before and after a helper prevents completion and next helper', async () => {
+  for (const before of [true, false]) {
+    let stopped = before;
+    let runCount = 0;
+    await assert.rejects(
+      runPretaskSequence([1, 2], {
+        throwIfStopped: () => {
+          if (stopped) throw new Error(CANCELLED);
+        },
+        run: async () => {
+          runCount++;
+          stopped = true;
+          return 0;
+        },
+        completed() {
+          assert.fail('cancelled helper cannot complete');
+        },
+        exitCodeError: String,
+      }),
+      new RegExp(CANCELLED),
+    );
+    assert.equal(runCount, before ? 0 : 1);
+  }
+});
+
+test('successful pre-tasks request reconnection, while an empty set does not', async () => {
+  const callbacks = {
+    throwIfStopped() {},
+    run: async () => 0,
+    completed() {},
+    exitCodeError: String,
+  };
+  assert.equal(await runPretaskSequence([], callbacks), false);
+  assert.equal(await runPretaskSequence([1, 2], callbacks), true);
+});
+
+test('changed window title can recover after startup only when the match is unique', () => {
+  const current = { window_name: '剑网3 登录', handle: 2 };
+  const other = { window_name: '剑网3 其他', handle: 3 };
+  assert.equal(findWindowAfterPretask([current], '剑网3 旧标题', true), current);
+  assert.equal(findWindowAfterPretask([current], '剑网3 旧标题', false), undefined);
+  assert.equal(findWindowAfterPretask([current, other], '剑网3 旧标题', true), undefined);
+  assert.equal(
+    findWindowAfterPretask([current, { ...current, handle: 4 }], current.window_name, true),
+    undefined,
+  );
+});
+
+// Execute the actual Toolbar startup callback, replacing only its UI/native boundaries.
+const source = readFileSync(new URL('../src/components/Toolbar.tsx', import.meta.url), 'utf8');
+const ast = ts.createSourceFile(
+  'Toolbar.tsx',
+  source,
+  ts.ScriptTarget.Latest,
+  true,
+  ts.ScriptKind.TSX,
+);
+let startup: ts.ArrowFunction | undefined;
+function visit(node: ts.Node) {
+  if (
+    ts.isVariableDeclaration(node) &&
+    node.name.getText(ast) === 'startTasksForInstance' &&
+    node.initializer &&
+    ts.isCallExpression(node.initializer)
+  ) {
+    startup = node.initializer.arguments[0] as ts.ArrowFunction;
+  }
+  ts.forEachChild(node, visit);
+}
+visit(ast);
+assert.ok(startup, 'Toolbar startup callback must exist');
+const compiled = ts.transpile(`(${startup.getText(ast)})`, { target: ts.ScriptTarget.ES2022 });
+
+function toolbarHarness(
+  mode: 'success' | 'nonzero' | 'throw' | 'cancel',
+  onlyPretask = false,
+  windowCount = 1,
+) {
+  const calls: string[] = [];
+  let cancelled = false;
+  const pretasks = [{ name: 'launch', exec: 'launch.exe' }];
+  const selectedTasks = [{ id: 'launch', taskName: '__MXU_PRETASK__launch' }];
+  if (!onlyPretask) selectedTasks.push({ id: 'login', taskName: 'login' });
+  const instance = {
+    id: 'test',
+    name: 'test',
+    isRunning: false,
+    selectedTasks,
+    savedDevice: { windowName: '剑网3 旧标题' },
+  };
+  const ui = { status: null as string | null, connected: 'Connected' };
+  const lastStartCancelledRef = { current: false };
+  const start = vm.runInNewContext(compiled, {
+    Error,
+    PRE_ACTION_CANCELLED_ERROR: CANCELLED,
+    lastStartCancelledRef,
+    preActionControlledInstanceIdRef: { current: null },
+    projectInterface: {
+      controller: [{ name: 'game', type: 'Win32' }],
+      resource: [{ name: 'game' }],
+      pretask: pretasks,
+    },
+    selectedController: {},
+    selectedResource: {},
+    instanceConnectionStatus: { test: 'Connected' },
+    instanceResourceLoaded: { test: true },
+    basePath: 'test-only',
+    translations: {},
+    useAppStore: { getState: () => ({ globalOptionValues: {} }) },
+    t: (key: string, values?: { code?: number }) =>
+      values?.code === undefined ? key : `${key}: ${values.code}`,
+    log: { info() {}, warn() {}, error() {} },
+    addLog() {},
+    filterTasksForRun: (tasks: unknown) => tasks,
+    resolveCompatTaskDef() {},
+    isTaskCompatible: () => true,
+    validateInstanceCheckboxCounts: () => [],
+    requiresUnlockedWorkstation: () => true,
+    getPretaskItems: () => pretasks,
+    pretaskName: (p: { name: string }) => '__MXU_PRETASK__' + p.name,
+    isPretaskName: (name: string) => name.startsWith('__MXU_PRETASK__'),
+    getPretaskItem: () => pretasks[0],
+    resolveI18nText: (text: unknown) => text,
+    buildPretaskArgs: () => ['{}'],
+    runPretaskSequence,
+    findWindowAfterPretask,
+    beginPreActionControl: async () => {
+      calls.push('begin');
+    },
+    endPreActionControl: async () => {
+      calls.push('end');
+    },
+    throwIfPreActionStopped: () => {
+      if (cancelled) throw new Error(CANCELLED);
+    },
+    updateInstance: (_id: string, changes: object) => Object.assign(instance, changes),
+    setInstanceConnectionStatus: (_id: string, state: string) => {
+      ui.connected = state;
+    },
+    setInstanceTaskStatus: (_id: string, status: string | null) => {
+      ui.status = status;
+    },
+    setInstanceCurrentTaskId() {},
+    clearScheduleExecution() {},
+    setIsStopping() {},
+    normalizeAgentConfigs: () => undefined,
+    ensureMaaInitialized: async () => {
+      calls.push('init');
+    },
+    isDesktopWindowControllerType: (type: string) => type === 'Win32',
+    getDesktopWindowFilters: () => ({ classRegex: 'KGWin32App', titleRegex: '剑网3' }),
+    buildDesktopWindowControllerConfig: (_c: unknown, handle: number) => ({ handle }),
+    maaService: {
+      isWorkstationLocked: async () => false,
+      runPretask: async () => {
+        calls.push('pretask');
+        assert.equal(instance.isRunning, true, 'automatic updates must see startup as busy');
+        if (mode === 'throw') throw new Error('spawn failed');
+        if (mode === 'cancel') cancelled = true;
+        return mode === 'nonzero' ? 17 : 0;
+      },
+      createInstance: async () => {
+        calls.push('create');
+      },
+      findWin32Windows: async () =>
+        Array.from({ length: windowCount }, (_, i) => ({
+          window_name: '剑网3 登录' + i,
+          class_name: 'KGWin32App',
+          handle: 200 + i,
+        })),
+      onCallback: async () => () => {},
+      connectController: async (_id: string, config: { handle: number }) => {
+        calls.push('connect:' + config.handle);
+        throw new Error('TEST_AFTER_CONNECT');
+      },
+      getInstanceState: async () => {
+        calls.push('cached-connection');
+        return { connectionStatus: 'Connected', resourceLoaded: true };
+      },
+    },
+  });
+  return { calls, instance, ui, lastStartCancelledRef, run: () => start(instance) };
+}
+
+test('Toolbar blocks controller connection after nonzero exit or spawn exception', async () => {
+  for (const mode of ['nonzero', 'throw'] as const) {
+    const h = toolbarHarness(mode);
+    assert.equal(await h.run(), false);
+    assert.deepEqual(h.calls, ['begin', 'pretask', 'end']);
+    assert.equal(h.ui.status, 'Failed');
+    assert.equal(h.instance.isRunning, false);
+  }
+});
+
+test('Toolbar cancellation preserves cancelled status and never connects', async () => {
+  const h = toolbarHarness('cancel');
+  assert.equal(await h.run(), false);
+  assert.deepEqual(h.calls, ['begin', 'pretask', 'end']);
+  assert.equal(h.lastStartCancelledRef.current, true);
+  assert.equal(h.ui.status, null);
+});
+
+test('Toolbar allows a pretask-only run without connecting or loading a resource', async () => {
+  const h = toolbarHarness('success', true);
+  assert.equal(await h.run(), true);
+  assert.deepEqual(h.calls, ['begin', 'pretask', 'end']);
+  assert.equal(h.ui.status, 'Succeeded');
+  assert.equal(h.ui.connected, 'Disconnected');
+  assert.equal(h.instance.isRunning, false);
+});
+
+test('Toolbar refreshes an existing controller and accepts a unique new window title', async () => {
+  const h = toolbarHarness('success');
+  await h.run();
+  assert.deepEqual(h.calls, ['begin', 'pretask', 'end', 'init', 'create', 'connect:200']);
+});
+
+test('Toolbar does not select among multiple new windows after startup', async () => {
+  const h = toolbarHarness('success', false, 2);
+  assert.equal(await h.run(), false);
+  assert.equal(
+    h.calls.some((call) => call.startsWith('connect:')),
+    false,
+  );
+});
