{
    "导出日志": {
        "recognition": "DirectHit",
        "action": "Command",
        "exec": "{RESOURCE_DIR}/../tools/bjx-run.exe",
        "args": [
            "-NoProfile",
            "-File",
            "{RESOURCE_DIR}/../tools/export-log.ps1"
        ],
        "timeout": 20000
    },
    "探测前确认": {
        "recognition": "DirectHit",
        "action": "Command",
        "exec": "{RESOURCE_DIR}/../tools/bjx-run.exe",
        "args": [
            "-NoProfile",
            "-File",
            "{RESOURCE_DIR}/../tools/remind-resolution.ps1",
            "{ENTRY}"
        ],
        "timeout": 20000,
        "next": [
            "探测游戏窗口"
        ]
    }
}
